filters:
  and:
    - file.tags.contains("film")
views:
  - type: cards
    name: Cards
    sort:
      - property: rating
        direction: DESC
    image: note.image
    cardSize: 210
    imageAspectRatio: 1
  - type: table
    name: Table
    order:
      - file.name
      - rating
    sort:
      - property: rating
        direction: DESC
    columnSize:
      file.name: 241
      note.rating: 184
