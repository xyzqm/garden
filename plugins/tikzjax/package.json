{
  "name": "@local/tikzjax",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "node-tikzjax": ">=1.0.0"
  },
  "quartz": {
    "name": "tikzjax",
